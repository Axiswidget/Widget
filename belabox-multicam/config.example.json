{
  "output": { "width": 3840, "height": 2160, "fps": 30 },

  "transition": { "type": "fade", "duration_ms": 600 },
  "audio_follows_video": true,
  "previews": true,
  "web": { "host": "0.0.0.0", "port": 8181 },

  "cameras": [
    {
      "name": "OM-1",
      "type": "usb",
      "device": "/dev/v4l/by-id/REPLACE-with-OM-1-entry-video-index0",
