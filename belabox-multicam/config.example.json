    },
    {
      "name": "Pocket 3",
      "type": "usb",
      "device": "/dev/v4l/by-id/REPLACE-with-DJI-Pocket-3-entry-video-index0",
      "audio": "auto"
    },
    {
      "name": "HDMI",
      "type": "v4l2",
      "device": "/dev/hdmirx",
      "audio": "hw:CARD=rockchiphdmiin"
    }
  ],

  "extra_audio": []
}
